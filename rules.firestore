rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Solo tu usuario (el mismo UID de firebase-init.js) puede escribir en las
    // colecciones "de administración". Comprobar solo request.auth != null NO
    // basta: cualquiera puede crearse una cuenta desde la página.
    // ÚNICO sitio donde aparece el UID del propietario. Si algún día cambia, se cambia aquí.
    function uidPropietario() {
      return "KxbZfGljpRdTIQlnOPDqjUs61v73";
    }

    function esPropietario() {
      return request.auth != null && request.auth.uid == uidPropietario();
    }

    // Rol «Admin inferior»: documento roles/{uid} con adminInferior == true, que SOLO
    // puede crear o borrar el propietario. Su ÚNICO efecto es poder publicar y editar
    // exámenes y tareas GLOBALES del calendario (ver esAdminGlobal más abajo). No da
    // acceso a apuntes, orden del árbol, roles ni datos de otros usuarios.
    function esAdminInferior() {
      return request.auth != null
          && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
          && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.adminInferior == true;
    }

    // Puede gestionar el calendario global: propietario o Admin inferior.
    function esAdminGlobal() {
      return esPropietario() || esAdminInferior();
    }

    // Documento único que guarda el orden de carpetas/archivos del árbol.
    // Cualquiera puede leerlo (así todos los visitantes ven el orden
    // personalizado), pero SOLO tu usuario autorizado puede escribirlo.
    match /site/order {
      allow read: if true;
      allow write: if esPropietario();
    }

    // Metadatos de los apuntes (gestor #firebase-apuntes). Los archivos viven en
    // Cloudinary; aquí solo se guarda su registro. Lectura pública.
    //
    // SUBIR (create): cualquier usuario con sesión, con la forma exacta que genera el JS.
    // OJO: el registro es abierto, así que cualquiera puede crearse una cuenta y subir.
    // Si prefieres que solo suba el propietario, cambia puedeSubirApunte() por esPropietario().
    // MOVER, REORDENAR y ELIMINAR: SOLO el propietario (mismo UID que firebase-init.js).
    function puedeSubirApunte() {
      return request.auth != null;
    }

    match /apuntes/{docId} {
      allow read: if true;

      // Crear: ni campos extra, ni tipos raros, ni URLs que no sean de tu cuenta
      // de Cloudinary, ni autor falsificado.
      allow create: if puedeSubirApunte()
        && request.resource.data.keys().hasOnly(['nombre', 'url', 'tipo', 'asignatura', 'orden', 'creado_por', 'fecha'])
        && request.resource.data.keys().hasAll(['nombre', 'url', 'tipo', 'asignatura', 'orden', 'creado_por', 'fecha'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 255
        && request.resource.data.asignatura is string
        && request.resource.data.asignatura.size() > 0
        && request.resource.data.asignatura.size() <= 100
        && request.resource.data.orden is int
        && request.resource.data.orden >= 0
        && request.resource.data.tipo in ['pdf', 'html']
        && request.resource.data.url is string
        && request.resource.data.url.matches('https://res[.]cloudinary[.]com/vagm1bzj/.*')
        && request.resource.data.creado_por == request.auth.uid
        && request.resource.data.fecha == request.time;

      // Mover de asignatura y reordenar: solo pueden cambiar "asignatura" y
      // "orden". Nombre, url, tipo, autor y fecha quedan inmutables.
      allow update: if esPropietario()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['asignatura', 'orden'])
        && request.resource.data.asignatura is string
        && request.resource.data.asignatura.size() > 0
        && request.resource.data.asignatura.size() <= 100
        && request.resource.data.orden is int
        && request.resource.data.orden >= 0;

      allow delete: if esPropietario();
    }

    // ------------------------------------------------------------------
    // CALENDARIO (calendario.html): exámenes y tareas con dos ÁMBITOS.
    // ------------------------------------------------------------------
    //   ambito 'global'   → lo crea SOLO un admin (esAdminGlobal: propietario o Admin
    //                       inferior) y lo lee CUALQUIERA, también sin sesión.
    //   ambito 'personal' → lo crea cualquier usuario con sesión, guarda su
    //                       usuario_uid y SOLO lo lee él (ni siquiera el admin).
    // Editar y borrar: el dueño (usuario_uid) o, si el evento es global, cualquier admin
    // (propietario o Admin inferior).
    // ambito, usuario_uid, tipo y creado son inmutables: un alumno no puede
    // "promocionar" un evento suyo a global ni quedarse con el de otro.
    //
    // OJO: las reglas NO filtran resultados. calendario.js hace dos consultas
    // que las cumplen: where('ambito','==','global') y where('usuario_uid','==',uid).
    // Un get() o una consulta sin esos filtros sobre eventos ajenos daría
    // permission-denied. Los documentos antiguos (sin ambito/usuario_uid) no
    // se pueden leer ni tocar: bórralos desde la consola de Firebase.
    function fechaIso(f) {
      return f is string
          && f.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }
    function textoObligatorio(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }
    function textoOpcional(v, max) {
      return v is string && v.size() <= max;
    }
    // Campos editables + forma según el tipo. Los exámenes llevan siempre
    // hora/lugar/temario (pueden ir vacíos); las tareas no los llevan.
    function eventoValido(d) {
      return d.keys().hasAll(['tipo', 'fecha', 'asignatura', 'titulo', 'ambito', 'usuario_uid', 'creado'])
          && d.tipo in ['examen', 'tarea']
          && d.ambito in ['global', 'personal']
          && d.usuario_uid is string
          && fechaIso(d.fecha)
          && textoObligatorio(d.asignatura, 60)
          && textoObligatorio(d.titulo, 100)
          && (d.tipo == 'examen'
              ? d.keys().hasOnly(['tipo', 'fecha', 'asignatura', 'titulo', 'hora', 'lugar', 'temario', 'ambito', 'usuario_uid', 'creado'])
                && d.keys().hasAll(['hora', 'lugar', 'temario'])
                && d.hora is string
                && (d.hora == '' || d.hora.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
                && textoOpcional(d.lugar, 60)
                && textoOpcional(d.temario, 1500)
              : d.keys().hasOnly(['tipo', 'fecha', 'asignatura', 'titulo', 'ambito', 'usuario_uid', 'creado']));
    }
    // ¿Puede quien hace la petición editar/borrar este evento (`e` = datos actuales)?
    function puedeGestionarEvento(e) {
      return request.auth != null
          && (e.usuario_uid == request.auth.uid
              || (esAdminGlobal() && e.ambito == 'global'));
    }

    match /calendario_eventos/{eventoId} {
      // Globales: todo el mundo. Personales: solo su dueño.
      allow read: if resource.data.ambito == 'global'
        || (request.auth != null && resource.data.usuario_uid == request.auth.uid);

      // Crear: el evento va a nombre de quien lo crea. Un alumno solo puede
      // crearlos personales; los globales exigen ser admin (propietario o Admin inferior).
      allow create: if request.auth != null
        && eventoValido(request.resource.data)
        && request.resource.data.usuario_uid == request.auth.uid
        && request.resource.data.creado == request.time
        && (request.resource.data.ambito == 'personal' || esAdminGlobal());

      // Editar: el dueño, o un admin si es global. Tipo, ámbito, dueño y
      // fecha de creación no pueden cambiar.
      allow update: if puedeGestionarEvento(resource.data)
        && eventoValido(request.resource.data)
        && request.resource.data.tipo == resource.data.tipo
        && request.resource.data.ambito == resource.data.ambito
        && request.resource.data.usuario_uid == resource.data.usuario_uid
        && request.resource.data.creado == resource.data.creado;

      allow delete: if puedeGestionarEvento(resource.data);
    }

    // ------------------------------------------------------------------
    // PERFILES Y ROLES
    // ------------------------------------------------------------------
    // ¿Es admin realmente? Propietario (UID fijo) o Admin inferior (roles/{id}). Es la
    // única fuente de verdad: usuarios/{uid}.esAdmin solo puede REFLEJARLA, así nadie
    // puede autoascenderse escribiendo esAdmin: true en su propio perfil.
    function esAdminDe(id) {
      return id == uidPropietario()
          || (exists(/databases/$(database)/documents/roles/$(id))
              && get(/databases/$(database)/documents/roles/$(id)).data.adminInferior == true);
    }

    // usuarios/{uid}: { uid, nombre, email, esAdmin, creado, actualizado }.
    //  - Cada usuario crea y edita SOLO su documento (request.auth.uid == userId). El email
    //    debe ser el de su cuenta y esAdmin solo puede valer lo que diga roles/{uid}.
    //  - El propietario (Admin Principal) puede LEER todos los documentos (así lista a los
    //    usuarios en el panel de administración) y ACTUALIZAR únicamente `esAdmin`
    //    (+ `actualizado`) de los demás.
    //  - Nadie borra perfiles desde el cliente.
    match /usuarios/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || esPropietario());

      // Crear el propio perfil.
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'nombre', 'email', 'esAdmin', 'creado', 'actualizado'])
        && request.resource.data.keys().hasAll(['uid', 'nombre', 'email', 'esAdmin', 'creado', 'actualizado'])
        && request.resource.data.uid == userId
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 60
        && request.resource.data.email is string
        && request.auth.token.email != null
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && request.resource.data.esAdmin is bool
        && request.resource.data.esAdmin == esAdminDe(userId)
        && request.resource.data.creado == request.time
        && request.resource.data.actualizado == request.time;

      // Editar el propio perfil: nombre, y rellenar/sincronizar uid, email y esAdmin
      // (cuentas antiguas). `creado` no cambia.
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'uid', 'email', 'esAdmin', 'actualizado'])
        && request.resource.data.uid == userId
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 60
        && request.resource.data.email is string
        && request.auth.token.email != null
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && request.resource.data.esAdmin is bool
        && request.resource.data.esAdmin == esAdminDe(userId)
        && request.resource.data.actualizado == request.time;

      // Admin Principal: solo puede cambiar `esAdmin` de otros usuarios.
      allow update: if esPropietario()
        && request.auth.uid != userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['esAdmin', 'actualizado'])
        && request.resource.data.esAdmin is bool
        && request.resource.data.actualizado == request.time;

      allow delete: if false;
    }

    // roles/{uid}: { adminInferior: true, asignado_por, actualizado }.
    // Solo el propietario concede (crea/edita) o revoca (borra) el rol. Cada usuario puede
    // leer el SUYO (para saber si ve los controles del calendario) y el propietario, todos.
    match /roles/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || esPropietario());

      allow create, update: if esPropietario()
        && uid != request.auth.uid
        && request.resource.data.keys().hasOnly(['adminInferior', 'asignado_por', 'actualizado'])
        && request.resource.data.keys().hasAll(['adminInferior', 'asignado_por', 'actualizado'])
        && request.resource.data.adminInferior == true
        && request.resource.data.asignado_por == request.auth.uid
        && request.resource.data.actualizado == request.time;

      allow delete: if esPropietario();
    }

    // Tareas marcadas como completadas: un documento por usuario, privado.
    // { hechas: { <idTarea>: true }, actualizado: <timestamp> }
    match /calendario_hechas/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['hechas', 'actualizado'])
        && request.resource.data.hechas is map
        && request.resource.data.hechas.size() <= 500
        && request.resource.data.actualizado == request.time;

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Progreso de las apps de apuntes tipo "entornos-desarrollo.html"
    // (una por curso/asignatura, identificada por su APP.sello). Cada
    // usuario, sea quien sea (cualquiera puede crear una cuenta desde la
    // propia página), solo puede leer y escribir SU PROPIO documento.
    // Nadie puede leer ni tocar el progreso de otro compañero.
    //
    // Forma que escribe entornos-desarrollo.html (ver molde()/sanea() de esa página):
    //   { v: 1, alumno: string (<= 60), ej: map (<= 4000), q: map (<= 4000), ts: número }
    // Las reglas no pueden recorrer el contenido de los mapas: se limita su nº de entradas
    // (un documento de Firestore no puede pasar de 1 MB de todas formas).
    //
    // SELLOS PERMITIDOS: sin esta lista, cada usuario podría crear documentos ilimitados
    // bajo cualquier «sello» inventado. AL PUBLICAR UNA APP NUEVA (o un sello nuevo en
    // APP.sello), añade aquí su valor exacto.
    function selloPermitido(sello) {
      return sello in ['2026-09-04-ed-dam-curso-completo', 'lm-dam-curso'];
    }

    function progresoValido(d) {
      return d.keys().hasOnly(['v', 'alumno', 'ej', 'q', 'ts'])
          && d.keys().hasAll(['v', 'alumno', 'ej', 'q', 'ts'])
          && d.v == 1
          && d.alumno is string && d.alumno.size() <= 60
          && d.ej is map && d.ej.size() <= 4000
          && d.q is map && d.q.size() <= 4000
          && d.ts is number;
    }

    match /progreso/{sello}/usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid
        && selloPermitido(sello);
      allow create, update: if request.auth != null && request.auth.uid == uid
        && selloPermitido(sello)
        && progresoValido(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == uid
        && selloPermitido(sello);
    }

    // Asignaturas convalidadas/aprobadas, marcadas desde horario.html.
    // Es un dato personal del alumno (no depende de un curso concreto),
    // así que va en su propio documento, uno por usuario.
    // Forma que escribe js/horario-cuenta.js: { materias: [códigos de asignatura], ts: número }.
    // Hay ~10 asignaturas en el horario; el tope de 30 deja margen. (Las reglas no pueden
    // comprobar el tipo de cada elemento de la lista.)
    match /convalidaciones/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['materias', 'ts'])
        && request.resource.data.keys().hasAll(['materias', 'ts'])
        && request.resource.data.materias is list
        && request.resource.data.materias.size() <= 30
        && request.resource.data.ts is number;

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Favoritos de cada usuario (los apuntes que marca con la estrella): { rutas: [texto], ts: número }.
    // Las reglas no pueden comprobar cada elemento de la lista; se limita su tamaño (igual que
    // MAX_FAVORITOS en js/firebase-core.js).
    match /favoritos/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['rutas', 'ts'])
        && request.resource.data.keys().hasAll(['rutas', 'ts'])
        && request.resource.data.rutas is list
        && request.resource.data.rutas.size() <= 300
        && request.resource.data.ts is number;

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Todo lo demás, bloqueado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }

    // ====================== CHAT ======================
    // Grupo «general» (todos los usuarios con sesión) + grupos de 2 a 30 personas. Sin chats privados
    // aparte de esos grupos, nadie sale de un grupo y cada uno solo borra sus propios mensajes.
    function chatLogueado() { return request.auth != null; }
    function chatMiembro(chatId) {
      return chatLogueado() && (chatId == 'general'
        || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.miembros);
    }

    // Directorio: solo el nombre visible (sin correo) para poder elegir compañeros al crear un grupo.
    match /directorio/{uid} {
      allow read: if chatLogueado();
      // Cada alumno se registra a sí mismo; el propietario (Admin Principal) registra a los demás pero NO se registra:
      // así es invisible para el resto.
      allow create, update: if chatLogueado()
        && ((request.auth.uid == uid && !esPropietario()) || (esPropietario() && request.auth.uid != uid))
        && request.resource.data.keys().hasOnly(['nombre'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 1 && request.resource.data.nombre.size() <= 60;
      allow delete: if false;
    }

    match /chats/{chatId} {
      allow read: if esPropietario() || (chatLogueado() && chatId != 'general' && request.auth.uid in resource.data.miembros);
      allow create: if chatLogueado() && !esPropietario() && chatId != 'general'
        && request.resource.data.keys().hasOnly(['nombre','miembros','creador','creado'])
        && request.resource.data.creador == request.auth.uid
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 1 && request.resource.data.nombre.size() <= 40
        && request.resource.data.miembros is list
        && request.resource.data.miembros.size() >= 2 && request.resource.data.miembros.size() <= 30
        && request.auth.uid in request.resource.data.miembros
        && request.resource.data.creado == request.time;
      allow update, delete: if false;
    }

    match /chats/{chatId}/mensajes/{msgId} {
      allow read: if esPropietario() || chatMiembro(chatId);
      allow create: if chatMiembro(chatId) && !esPropietario()
        && request.resource.data.keys().hasOnly(['uid','autor','texto','archivo','creado'])
        && request.resource.data.keys().hasAll(['uid','autor','texto','creado'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.autor is string
        && request.resource.data.autor.size() >= 1 && request.resource.data.autor.size() <= 60
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 2000
        && (request.resource.data.texto.size() > 0 || 'archivo' in request.resource.data)
        && (!('archivo' in request.resource.data) || (request.resource.data.archivo is map
            && request.resource.data.archivo.keys().hasOnly(['url','nombre','tam'])
            && request.resource.data.archivo.url is string
            && request.resource.data.archivo.url.matches('https://res[.]cloudinary[.]com/vagm1bzj/.*')))
        && request.resource.data.creado == request.time;
      allow delete: if chatLogueado() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
  }
}
