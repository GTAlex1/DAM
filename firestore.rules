rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Solo tu usuario (el mismo UID de firebase-init.js) puede escribir en las
    // colecciones "de administración". Comprobar solo request.auth != null NO
    // basta: cualquiera puede crearse una cuenta desde la página.
    function esPropietario() {
      return request.auth != null
          && request.auth.uid == "KxbZfGljpRdTIQlnOPDqjUs61v73";
    }

    // Documento único que guarda el orden de carpetas/archivos del árbol.
    // Cualquiera puede leerlo (así todos los visitantes ven el orden
    // personalizado), pero SOLO tu usuario autorizado puede escribirlo.
    match /site/order {
      allow read: if true;
      allow write: if esPropietario();
    }

    // Metadatos de los apuntes (gestor #firebase-apuntes). Los archivos viven en
    // Cloudinary; aquí solo se guarda su registro. Lectura pública.
    //
    // La escritura es SOLO del propietario (mismo UID que firebase-init.js).
    // No basta con "request.auth != null": cualquiera puede crearse una cuenta
    // desde la página y podría subir, mover o reordenar tus apuntes.
    match /apuntes/{docId} {
      allow read: if true;

      // Crear: forma exacta que genera el JS. Ni campos extra, ni tipos raros,
      // ni URLs que no sean de tu cuenta de Cloudinary, ni autor falsificado.
      allow create: if esPropietario()
        && request.resource.data.keys().hasOnly(['nombre', 'url', 'tipo', 'asignatura', 'orden', 'creado_por', 'fecha'])
        && request.resource.data.keys().hasAll(['nombre', 'url', 'tipo', 'asignatura', 'orden', 'creado_por', 'fecha'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 255
        && request.resource.data.asignatura is string
        && request.resource.data.asignatura.size() > 0
        && request.resource.data.asignatura.size() <= 100
        && request.resource.data.orden is int
        && request.resource.data.orden >= 0
        && request.resource.data.tipo in ['pdf', 'html']
        && request.resource.data.url is string
        && request.resource.data.url.matches('https://res[.]cloudinary[.]com/vagm1bzj/.*')
        && request.resource.data.creado_por == request.auth.uid
        && request.resource.data.fecha == request.time;

      // Mover de asignatura y reordenar: solo pueden cambiar "asignatura" y
      // "orden". Nombre, url, tipo, autor y fecha quedan inmutables.
      allow update: if esPropietario()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['asignatura', 'orden'])
        && request.resource.data.asignatura is string
        && request.resource.data.asignatura.size() > 0
        && request.resource.data.asignatura.size() <= 100
        && request.resource.data.orden is int
        && request.resource.data.orden >= 0;

      allow delete: if esPropietario();
    }

    // ------------------------------------------------------------------
    // CALENDARIO (calendario.html): exámenes y tareas con dos ÁMBITOS.
    // ------------------------------------------------------------------
    //   ambito 'global'   → lo crea SOLO el admin (esPropietario) y lo lee CUALQUIERA,
    //                       también sin sesión.
    //   ambito 'personal' → lo crea cualquier usuario con sesión, guarda su
    //                       usuario_uid y SOLO lo lee él (ni siquiera el admin).
    // Editar y borrar: el dueño (usuario_uid) o, si el evento es global, el admin.
    // ambito, usuario_uid, tipo y creado son inmutables: un alumno no puede
    // "promocionar" un evento suyo a global ni quedarse con el de otro.
    //
    // OJO: las reglas NO filtran resultados. calendario.js hace dos consultas
    // que las cumplen: where('ambito','==','global') y where('usuario_uid','==',uid).
    // Un get() o una consulta sin esos filtros sobre eventos ajenos daría
    // permission-denied. Los documentos antiguos (sin ambito/usuario_uid) no
    // se pueden leer ni tocar: bórralos desde la consola de Firebase.
    function fechaIso(f) {
      return f is string
          && f.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }
    function textoObligatorio(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }
    function textoOpcional(v, max) {
      return v is string && v.size() <= max;
    }
    // Campos editables + forma según el tipo. Los exámenes llevan siempre
    // hora/lugar/temario (pueden ir vacíos); las tareas no los llevan.
    function eventoValido(d) {
      return d.keys().hasAll(['tipo', 'fecha', 'asignatura', 'titulo', 'ambito', 'usuario_uid', 'creado'])
          && d.tipo in ['examen', 'tarea']
          && d.ambito in ['global', 'personal']
          && d.usuario_uid is string
          && fechaIso(d.fecha)
          && textoObligatorio(d.asignatura, 60)
          && textoObligatorio(d.titulo, 100)
          && (d.tipo == 'examen'
              ? d.keys().hasOnly(['tipo', 'fecha', 'asignatura', 'titulo', 'hora', 'lugar', 'temario', 'ambito', 'usuario_uid', 'creado'])
                && d.keys().hasAll(['hora', 'lugar', 'temario'])
                && d.hora is string
                && (d.hora == '' || d.hora.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
                && textoOpcional(d.lugar, 60)
                && textoOpcional(d.temario, 1500)
              : d.keys().hasOnly(['tipo', 'fecha', 'asignatura', 'titulo', 'ambito', 'usuario_uid', 'creado']));
    }
    // ¿Puede quien hace la petición editar/borrar este evento (`e` = datos actuales)?
    function puedeGestionarEvento(e) {
      return request.auth != null
          && (e.usuario_uid == request.auth.uid
              || (esPropietario() && e.ambito == 'global'));
    }

    match /calendario_eventos/{eventoId} {
      // Globales: todo el mundo. Personales: solo su dueño.
      allow read: if resource.data.ambito == 'global'
        || (request.auth != null && resource.data.usuario_uid == request.auth.uid);

      // Crear: el evento va a nombre de quien lo crea. Un alumno solo puede
      // crearlos personales; los globales exigen ser el admin.
      allow create: if request.auth != null
        && eventoValido(request.resource.data)
        && request.resource.data.usuario_uid == request.auth.uid
        && request.resource.data.creado == request.time
        && (request.resource.data.ambito == 'personal' || esPropietario());

      // Editar: el dueño, o el admin si es global. Tipo, ámbito, dueño y
      // fecha de creación no pueden cambiar.
      allow update: if puedeGestionarEvento(resource.data)
        && eventoValido(request.resource.data)
        && request.resource.data.tipo == resource.data.tipo
        && request.resource.data.ambito == resource.data.ambito
        && request.resource.data.usuario_uid == resource.data.usuario_uid
        && request.resource.data.creado == resource.data.creado;

      allow delete: if puedeGestionarEvento(resource.data);
    }

    // Tareas marcadas como completadas: un documento por usuario, privado.
    // { hechas: { <idTarea>: true }, actualizado: <timestamp> }
    match /calendario_hechas/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['hechas', 'actualizado'])
        && request.resource.data.hechas is map
        && request.resource.data.hechas.size() <= 500
        && request.resource.data.actualizado == request.time;

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Progreso de las apps de apuntes tipo "entornos-desarrollo.html"
    // (una por curso/asignatura, identificada por su APP.sello). Cada
    // usuario, sea quien sea (cualquiera puede crear una cuenta desde la
    // propia página), solo puede leer y escribir SU PROPIO documento.
    // Nadie puede leer ni tocar el progreso de otro compañero.
    match /progreso/{sello}/usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Asignaturas convalidadas/aprobadas, marcadas desde horario.html.
    // Es un dato personal del alumno (no depende de un curso concreto),
    // así que va en su propio documento, uno por usuario.
    match /convalidaciones/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Todo lo demás, bloqueado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}