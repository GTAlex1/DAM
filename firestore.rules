rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Solo tu usuario (el mismo UID de firebase-init.js) puede escribir en las
    // colecciones "de administración". Comprobar solo request.auth != null NO
    // basta: cualquiera puede crearse una cuenta desde la página.
    function esPropietario() {
      return request.auth != null
          && request.auth.uid == "KxbZfGljpRdTIQlnOPDqjUs61v73";
    }

    // Documento único que guarda el orden de carpetas/archivos del árbol.
    // Cualquiera puede leerlo (así todos los visitantes ven el orden
    // personalizado), pero SOLO tu usuario autorizado puede escribirlo.
    match /site/order {
      allow read: if true;
      allow write: if esPropietario();
    }

    // Metadatos de los apuntes (gestor #firebase-apuntes). Los archivos viven en
    // Cloudinary; aquí solo se guarda su registro. Lectura pública.
    //
    // La escritura es SOLO del propietario (mismo UID que firebase-init.js).
    // No basta con "request.auth != null": cualquiera puede crearse una cuenta
    // desde la página y podría subir, mover o reordenar tus apuntes.
    match /apuntes/{docId} {
      allow read: if true;

      // Crear: forma exacta que genera el JS. Ni campos extra, ni tipos raros,
      // ni URLs que no sean de tu cuenta de Cloudinary, ni autor falsificado.
      allow create: if esPropietario()
        && request.resource.data.keys().hasOnly(['nombre', 'url', 'tipo', 'asignatura', 'orden', 'creado_por', 'fecha'])
        && request.resource.data.keys().hasAll(['nombre', 'url', 'tipo', 'asignatura', 'orden', 'creado_por', 'fecha'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 255
        && request.resource.data.asignatura is string
        && request.resource.data.asignatura.size() > 0
        && request.resource.data.asignatura.size() <= 100
        && request.resource.data.orden is int
        && request.resource.data.orden >= 0
        && request.resource.data.tipo in ['pdf', 'html']
        && request.resource.data.url is string
        && request.resource.data.url.matches('https://res[.]cloudinary[.]com/vagm1bzj/.*')
        && request.resource.data.creado_por == request.auth.uid
        && request.resource.data.fecha == request.time;

      // Mover de asignatura y reordenar: solo pueden cambiar "asignatura" y
      // "orden". Nombre, url, tipo, autor y fecha quedan inmutables.
      allow update: if esPropietario()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['asignatura', 'orden'])
        && request.resource.data.asignatura is string
        && request.resource.data.asignatura.size() > 0
        && request.resource.data.asignatura.size() <= 100
        && request.resource.data.orden is int
        && request.resource.data.orden >= 0;

      allow delete: if esPropietario();
    }

    // Progreso de las apps de apuntes tipo "entornos-desarrollo.html"
    // (una por curso/asignatura, identificada por su APP.sello). Cada
    // usuario, sea quien sea (cualquiera puede crear una cuenta desde la
    // propia página), solo puede leer y escribir SU PROPIO documento.
    // Nadie puede leer ni tocar el progreso de otro compañero.
    match /progreso/{sello}/usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Asignaturas convalidadas/aprobadas, marcadas desde horario.html.
    // Es un dato personal del alumno (no depende de un curso concreto),
    // así que va en su propio documento, uno por usuario.
    match /convalidaciones/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Todo lo demás, bloqueado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
